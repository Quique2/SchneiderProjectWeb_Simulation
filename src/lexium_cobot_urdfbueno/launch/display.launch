<?xml version="1.0"?>
<launch>
  <arg name="use_gui" default="true"/>
  <param name="robot_description"
         textfile="$(find lexium_cobot_urdfbueno)/urdf/lexium_cobot_l03s.urdf"/>
  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui"
        type="joint_state_publisher_gui" if="$(arg use_gui)"/>
  <node name="joint_state_publisher" pkg="joint_state_publisher"
        type="joint_state_publisher" unless="$(arg use_gui)"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher"
        type="robot_state_publisher"/>
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find lexium_cobot_urdfbueno)/rviz/display.rviz"/>
</launch>
