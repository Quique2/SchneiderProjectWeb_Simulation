<?xml version="1.0"?>
<!--
  lexium_cobot_l03s.urdf  -  V36 corrected canonical URDF
  ===========================================================================
  Originally Cobot_URDFBUENO.zip (user delivery); mesh paths rewritten
  as package://lexium_cobot_urdfbueno/meshes/<name>.STL per ROS convention.

  V36 CORRECTIONS (user-authorised, see lexium_cobot_l03s_macro.xacro):
    * joint_2 origin rpy "0 0 0.05" -> "0 0 0".  The 2.86 deg skew was
      a CAD measurement artifact producing a small visible "wobble" at
      q=0.  Removed so the chain centerline is straight at q=0.

  All OTHER joint origins, axes, centers of rotation, mesh-to-link
  assignments, the tool0 fixed origin, the parent-child topology and
  joint limits remain identical to the original Cobot_URDFBUENO source.
  ===========================================================================
-->
<robot name="lexium_cobot_l03s">

  <material name="lexium_grey"><color rgba="0.40 0.40 0.45 1.0"/></material>
  <material name="lexium_dark"><color rgba="0.25 0.25 0.28 1.0"/></material>

  <link name="base_link">
    <visual><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link0_base.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_dark"/></visual>
    <collision><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link0_base.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="3.5"/><origin xyz="0.1623 0.0436 0.0645"/><inertia ixx="0.010" ixy="0" ixz="0" iyy="0.010" iyz="0" izz="0.008"/></inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link1_shoulder"/>
    <origin xyz="0.1623 0.0867 0.0645" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link1_shoulder">
    <visual><origin xyz="-0.1623 -0.0867 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link1_shoulder_rotation.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1623 -0.0867 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link1_shoulder_rotation.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="2.0"/><origin xyz="0 0.062 0"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/></inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link1_shoulder"/><child link="link2_upper_arm"/>
    <origin xyz="-0.0115 0.0639 0.0000" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link2_upper_arm">
    <visual><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link2_shoulder_connector.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link2_elbow_joint.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link3_elbow_connector.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link2_shoulder_connector.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="1.8"/><origin xyz="0 0.075 0"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.003"/></inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link2_upper_arm"/><child link="link3_forearm"/>
    <origin xyz="-0.0015 0.2450 0.2258" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link3_forearm">
    <visual><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link3_forearm.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link6_wrist3_cylinder.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link5_wrist2_body.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link3_forearm.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="1.2"/><origin xyz="0 0.117 0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/></inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link3_forearm"/><child link="link4_wrist1"/>
    <origin xyz="-0.0060 0.2295 0.1244" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <link name="link4_wrist1">
    <visual><origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link4_wrist1_cylinder.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link5_wrist2_cylinder.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link4_wrist1_cylinder.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="0.8"/><origin xyz="0 0.021 0"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="link4_wrist1"/><child link="link5_wrist2"/>
    <origin xyz="-0.0010 0.0465 -0.2300" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.09440" upper="2.09440" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <link name="link5_wrist2">
    <visual><origin xyz="-0.1423 -0.6716 -0.1847" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link6_wrist3_upper_body.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1423 -0.6716 -0.1847" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link6_wrist3_upper_body.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="0.4"/><origin xyz="0 0.061 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="link5_wrist2"/><child link="link6_wrist3"/>
    <origin xyz="-0.0040 0.0720 0.0898" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link6_wrist3">
    <visual><origin xyz="-0.1383 -0.7436 -0.2745" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link6_tool_flange.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_dark"/></visual>
    <collision><origin xyz="-0.1383 -0.7436 -0.2745" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_urdfbueno/meshes/link6_tool_flange.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="0.3"/><origin xyz="0 0.034 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_tool0" type="fixed">
    <parent link="link6_wrist3"/><child link="tool0"/>
    <origin xyz="0 0.068 0" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>

</robot>
