<?xml version="1.0"?>
<!--
  lexium_cobot_with_final_gripper.xacro  -  V61 (URDF DEFINITIVO)

  Wrapper xacro alrededor del URDF DEFINITIVO V61
  (lexium_cobot_with_final_gripper.urdf, derivado del archivo provisto
  en URDF_DEFINITIVO.zip "lexium_cobot_v26.urdf").

  Esta macro SOLO hace tres cosas mas alla del URDF original:
    (1) prefija cada link/joint con ${name}_ para soportar multiples
        instancias;
    (2) reemplaza el `world_to_base_link_z_reference` del URDF por una
        junta parametrizada parent->base_link (`${parent}_to_${name}_base_link`)
        para anclar la macro en cualquier mount;
    (3) expone un alias logico ${name}_tcp_grasp_center co-localizado con
        tcp_link, que el resto de la planta (robot_controller,
        object_manager, gripper sim, collision filter) direcciona por
        nombre.

  Cinematica revolute/prismatic + visual origins + meshes son IDENTICOS al
  URDF DEFINITIVO V61.  Se preserva la extraccion de link3_elbow_connector
  como link independiente con `joint_elbow_connector` (fixed, rpy=(0,pi,0)).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="lexium_cobot_with_final_gripper"
               params="name parent mount_xyz:='0 0 0' mount_rpy:='0 0 0'">

    <!-- materials -->
    <material name="${name}_lexium_grey"><color rgba="0.40 0.40 0.45 1.0"/></material>
    <material name="${name}_lexium_dark"><color rgba="0.25 0.25 0.28 1.0"/></material>
    <material name="${name}_gripper_dark_gray"><color rgba="0.18 0.18 0.18 1"/></material>
    <material name="${name}_gripper_light_gray"><color rgba="0.70 0.70 0.70 1"/></material>
    <material name="${name}_gripper_medium_gray"><color rgba="0.45 0.45 0.45 1"/></material>
    <material name="${name}_gripper_blue_gray"><color rgba="0.25 0.33 0.42 1"/></material>
    <material name="${name}_gripper_red"><color rgba="0.85 0.05 0.05 1"/></material>

    <!-- ===== anchor (replaces world_to_base_link_z_reference) ========= -->
    <joint name="${parent}_to_${name}_base_link" type="fixed">
      <parent link="${parent}"/>
      <child  link="${name}_base_link"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>

    <!-- ===== base_link =============================================== -->
    <link name="${name}_base_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link0_base.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_dark"/>
      </visual>
    </link>

    <joint name="${name}_joint_1" type="revolute">
      <parent link="${name}_base_link"/><child link="${name}_link1_shoulder"/>
      <origin xyz="0.1623 0.0867 0.0645" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50"/>
    </joint>

    <link name="${name}_link1_shoulder">
      <visual>
        <origin xyz="-0.1623 -0.0867 -0.0645" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link1_shoulder_rotation.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
    </link>

    <joint name="${name}_joint_2" type="revolute">
      <parent link="${name}_link1_shoulder"/><child link="${name}_link2_upper_arm"/>
      <origin xyz="-0.0115 0.0639 0" rpy="0 0 0.05"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.61799" upper="2.61799" velocity="3.14" effort="50"/>
    </joint>

    <link name="${name}_link2_upper_arm">
      <visual>
        <origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link2_shoulder_connector.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
      <visual>
        <origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link2_elbow_joint.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
    </link>

    <!-- V61: link3_elbow_connector extracted as independent link,
         heredando la rotacion 180Y concentrica del pivot. -->
    <joint name="${name}_joint_elbow_connector" type="fixed">
      <parent link="${name}_link2_upper_arm"/>
      <child  link="${name}_link_elbow_connector"/>
      <origin xyz="0.001060 0.243625 0.119967" rpy="0 3.14159265359 0"/>
    </joint>

    <link name="${name}_link_elbow_connector">
      <visual>
        <origin xyz="-0.151860 -0.394225 -0.172817" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link3_elbow_connector.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
    </link>

    <joint name="${name}_joint_3" type="revolute">
      <parent link="${name}_link_elbow_connector"/><child link="${name}_link3_forearm"/>
      <origin xyz="0.002560 0.001375 0.113592" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.61799" upper="2.61799" velocity="3.14" effort="50"/>
    </joint>

    <link name="${name}_link3_forearm">
      <visual>
        <origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link3_forearm.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
      <visual>
        <origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_wrist3_cylinder.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
      <visual>
        <origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link5_wrist2_body.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
    </link>

    <joint name="${name}_joint_4" type="revolute">
      <parent link="${name}_link3_forearm"/><child link="${name}_link4_wrist1"/>
      <origin xyz="-0.0060 0.2295 0.1244" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50"/>
    </joint>

    <link name="${name}_link4_wrist1">
      <visual>
        <origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link4_wrist1_cylinder.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
      <visual>
        <origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link5_wrist2_cylinder.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
    </link>

    <joint name="${name}_joint_5" type="revolute">
      <parent link="${name}_link4_wrist1"/><child link="${name}_link5_wrist2"/>
      <origin xyz="-0.0010 0.0465 -0.2300" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-2.09440" upper="2.09440" velocity="3.14" effort="50"/>
    </joint>

    <link name="${name}_link5_wrist2">
      <visual>
        <origin xyz="-0.1423 -0.6716 -0.1847" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_wrist3_upper_body.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_grey"/>
      </visual>
    </link>

    <joint name="${name}_joint_6" type="revolute">
      <parent link="${name}_link5_wrist2"/><child link="${name}_link6_wrist3"/>
      <origin xyz="-0.0040 0.0720 0.0898" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50"/>
    </joint>

    <link name="${name}_link6_wrist3">
      <visual>
        <origin xyz="-0.1383 -0.7436 -0.2745" rpy="0 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_tool_flange.STL" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_lexium_dark"/>
      </visual>
    </link>

    <joint name="${name}_joint_tool0" type="fixed">
      <parent link="${name}_link6_wrist3"/><child link="${name}_tool0"/>
      <origin xyz="0 0.068 0" rpy="0 0 0"/>
    </joint>
    <link name="${name}_tool0"/>

    <!-- ===== gripper (URDF DEFINITIVO V61 verbatim) =================== -->
    <joint name="${name}_tool0_to_gripper_base" type="fixed">
      <parent link="${name}_tool0"/>
      <child  link="${name}_gripper_base"/>
      <origin xyz="0 -0.07 0.015" rpy="0 0 0"/>
    </joint>
    <link name="${name}_gripper_base"/>

    <link name="${name}_stump_link">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/stump.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_gripper_dark_gray"/>
      </visual>
    </link>
    <joint name="${name}_stump_fixed_joint" type="fixed">
      <parent link="${name}_gripper_base"/><child link="${name}_stump_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_fixture_link">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/fixture.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_gripper_light_gray"/>
      </visual>
    </link>
    <joint name="${name}_fixture_fixed_joint" type="fixed">
      <parent link="${name}_gripper_base"/><child link="${name}_fixture_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_fixture1_link">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/fixture1.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_gripper_medium_gray"/>
      </visual>
    </link>
    <joint name="${name}_fixture1_fixed_joint" type="fixed">
      <parent link="${name}_gripper_base"/><child link="${name}_fixture1_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_neck_link">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/neck.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_gripper_blue_gray"/>
      </visual>
    </link>
    <joint name="${name}_neck_fixed_joint" type="fixed">
      <parent link="${name}_gripper_base"/><child link="${name}_neck_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_appendage_link">
      <visual>
        <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
        <geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/appendage.stl" scale="0.001 0.001 0.001"/></geometry>
        <material name="${name}_gripper_red"/>
      </visual>
    </link>
    <joint name="${name}_appendage_prismatic_joint" type="prismatic">
      <parent link="${name}_gripper_base"/><child link="${name}_appendage_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.000" upper="0.028" effort="30" velocity="0.08"/>
    </joint>

    <link name="${name}_tcp_link"/>
    <joint name="${name}_tcp_fixed_joint" type="fixed">
      <parent link="${name}_appendage_link"/><child link="${name}_tcp_link"/>
      <origin xyz="0.000250 0.060250 0.076750" rpy="0 0 0"/>
    </joint>

    <!-- Alias logico usado por robot_controller, object_manager, gripper sim
         y collision filter:  ${name}_tcp_grasp_center co-localizado con
         ${name}_tcp_link. -->
    <link name="${name}_tcp_grasp_center"/>
    <joint name="${name}_tcp_grasp_center_fixed_joint" type="fixed">
      <parent link="${name}_tcp_link"/>
      <child  link="${name}_tcp_grasp_center"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_cafi_lateral_target_frame"/>
    <joint name="${name}_cafi_lateral_target_fixed_joint" type="fixed">
      <parent link="${name}_gripper_base"/>
      <child  link="${name}_cafi_lateral_target_frame"/>
      <origin xyz="0.000000 0.016600 0.076750" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
