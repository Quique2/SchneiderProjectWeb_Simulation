<?xml version="1.0"?>
<robot name="lexium_cobot_with_final_gripper">

  <material name="lexium_grey"><color rgba="0.40 0.40 0.45 1.0"/></material>
  <material name="lexium_dark"><color rgba="0.25 0.25 0.28 1.0"/></material>



  <!--
    Z REFERENCE WRAPPER
    This fixed joint rotates the complete cobot + gripper assembly so the old cobot +Y working direction
    becomes the global/reference +Z direction in RViz.
    Rotation used: +90 degrees around X.
  -->
  <link name="world"/>

  <joint name="world_to_base_link_z_reference" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
  </joint>

  <link name="base_link">
    <visual><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link0_base.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_dark"/></visual>
    <collision><origin xyz="0.0000 0.0000 0.0000" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link0_base.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="3.5"/><origin xyz="0.1623 0.0436 0.0645"/><inertia ixx="0.010" ixy="0" ixz="0" iyy="0.010" iyz="0" izz="0.008"/></inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link1_shoulder"/>
    <origin xyz="0.1623 0.0867 0.0645" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link1_shoulder">
    <visual><origin xyz="-0.1623 -0.0867 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link1_shoulder_rotation.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1623 -0.0867 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link1_shoulder_rotation.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="2.0"/><origin xyz="0 0.062 0"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.004"/></inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link1_shoulder"/><child link="link2_upper_arm"/>
    <origin xyz="-0.0115 0.0639 0.0000" rpy="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link2_upper_arm">
    <visual><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link2_shoulder_connector.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link2_elbow_joint.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link3_elbow_connector.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1508 -0.1506 -0.0645" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link2_shoulder_connector.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="1.8"/><origin xyz="0 0.075 0"/><inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.003"/></inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="link2_upper_arm"/><child link="link3_forearm"/>
    <origin xyz="-0.0015 0.2450 0.2258" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link3_forearm">
    <visual><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link3_forearm.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_wrist3_cylinder.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link5_wrist2_body.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1493 -0.3956 -0.2903" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link3_forearm.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="1.2"/><origin xyz="0 0.117 0"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.002"/></inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="link3_forearm"/><child link="link4_wrist1"/>
    <origin xyz="-0.0060 0.2295 0.1244" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <link name="link4_wrist1">
    <visual><origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link4_wrist1_cylinder.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <visual><origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link5_wrist2_cylinder.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1433 -0.6251 -0.4147" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link4_wrist1_cylinder.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="0.8"/><origin xyz="0 0.021 0"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_5" type="revolute">
    <parent link="link4_wrist1"/><child link="link5_wrist2"/>
    <origin xyz="-0.0010 0.0465 -0.2300" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.09440" upper="2.09440" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.3" friction="0.05"/>
  </joint>

  <link name="link5_wrist2">
    <visual><origin xyz="-0.1423 -0.6716 -0.1847" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_wrist3_upper_body.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_grey"/></visual>
    <collision><origin xyz="-0.1423 -0.6716 -0.1847" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_wrist3_upper_body.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="0.4"/><origin xyz="0 0.061 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_6" type="revolute">
    <parent link="link5_wrist2"/><child link="link6_wrist3"/>
    <origin xyz="-0.0040 0.0720 0.0898" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" velocity="3.14" effort="50.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link6_wrist3">
    <visual><origin xyz="-0.1383 -0.7436 -0.2745" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_tool_flange.STL" scale="0.001 0.001 0.001"/></geometry><material name="lexium_dark"/></visual>
    <collision><origin xyz="-0.1383 -0.7436 -0.2745" rpy="0 0 0"/><geometry><mesh filename="package://lexium_cobot_with_final_gripper/meshes/cobot/link6_tool_flange.STL" scale="0.001 0.001 0.001"/></geometry></collision>
    <inertial><mass value="0.3"/><origin xyz="0 0.034 0"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_tool0" type="fixed">
    <parent link="link6_wrist3"/><child link="tool0"/>
    <origin xyz="0 0.068 0" rpy="0 0 0"/>
  </joint>
  <link name="tool0"/>


  <!--
    GRIPPER MOUNT
    tool0 is the flange-center reference of the cobot.
    gripper_base is the center of stump_link / gripper mounting stump.
    origin xyz="0 0 0" means the center of stump_link is placed exactly at the center of the cobot flange.
  -->
  <joint name="tool0_to_gripper_base" type="fixed">
    <parent link="tool0"/>
    <child link="gripper_base"/>
    <origin xyz="0.0 -0.07 0.015" rpy="0 0 0"/>
  </joint>


  <!--
    URDF generated from the uploaded STL gripper parts.
    Units:
      - STL files were detected in millimeters.
      - Mesh scale="0.001 0.001 0.001" converts them to meters for ROS.
    Origin:
      - Mesh vertices were shifted so gripper_base is located at the center of the stump/mount plate.
      - This makes the gripper easier to mount to a robot flange.
      - All mesh visuals/collisions are rotated rpy="-1.57079632679 0 0" so the old CAD -Y working direction becomes URDF +Z.
  -->

  <!--
    IMPORTANT MOUNTING FRAME:
    gripper_base is exactly at the center of stump_link / mounting stump.
    Attach your cobot flange to this frame so placement is simple:
    flange_link -> gripper_base, origin xyz="0 0 0" unless you need a rotation offset.
  -->
  <link name="gripper_base"/>

  <!-- Small visual-only marker at the stump/flange center. Remove this link if you do not want to see the center dot in RViz. -->
  <link name="stump_center_marker_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.004"/>
      </geometry>
      <material name="mount_center_green">
        <color rgba="0.0 1.0 0.0 0.85"/>
      </material>
    </visual>
  </link>

  <joint name="stump_center_marker_fixed_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="stump_center_marker_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Visual-only Z reference: this thin blue cylinder shows the gripper's local +Z working/open-close axis. -->
  <link name="z_axis_reference_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0015" length="0.12"/>
      </geometry>
      <material name="z_axis_blue">
        <color rgba="0.0 0.25 1.0 0.75"/>
      </material>
    </visual>
  </link>

  <joint name="z_axis_reference_fixed_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="z_axis_reference_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="stump_link">
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/stump.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.18 0.18 0.18 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/stump.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="stump_fixed_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="stump_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="fixture_link">
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/fixture.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_gray">
        <color rgba="0.70 0.70 0.70 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/fixture.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="fixture_fixed_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="fixture_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="fixture1_link">
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/fixture1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="medium_gray">
        <color rgba="0.45 0.45 0.45 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/fixture1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="fixture1_fixed_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="fixture1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="neck_link">
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/neck.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue_gray">
        <color rgba="0.25 0.33 0.42 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/neck.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="neck_fixed_joint" type="fixed">
    <parent link="gripper_base"/>
    <child link="neck_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="appendage_link">
    <visual>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/appendage.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red_gripper">
        <color rgba="0.85 0.05 0.05 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://lexium_cobot_with_final_gripper/meshes/gripper/appendage.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!--
    Moving jaw / appendage.
    The appendage is prismatic so it can slide open/closed in RViz using joint_state_publisher_gui.
    Axis is along local +Y.
    The full gripper mesh set is still visually/collision-rotated so the gripper body keeps the Z-oriented reference requested before.
    q = 0.000 m keeps the uploaded CAD closed/reference position.
    Positive q moves the appendage toward +Y. Limit: 0.028 m / 2.8 cm (V48; was 0.015 in V46).
  -->
  <joint name="appendage_prismatic_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="appendage_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.000" upper="0.028" effort="30" velocity="0.08"/>
    <dynamics damping="1.0" friction="0.1"/>
  </joint>

  <!-- TCP placed at the front/working tip of the appendage. Adjust this if your real gripping point is different. -->
  <link name="tcp_link"/>

  <joint name="tcp_fixed_joint" type="fixed">
    <parent link="appendage_link"/>
    <child link="tcp_link"/>
    <origin xyz="0.000250 0.060250 0.076750" rpy="0 0 0"/>
  </joint>


</robot>
