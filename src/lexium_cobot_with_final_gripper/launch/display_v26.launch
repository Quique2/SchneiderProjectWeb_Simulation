<launch>
  <!--
    display_v26.launch  -  Loads the URDF DEFINITIVO V26 file shipped
    in this package as `urdf/lexium_cobot_v26.urdf`.  This is the
    "tal cual" V26 reference URDF (link3_elbow_connector extracted as
    independent link, downstream visual origins identical to URDF
    definitivo original, revolute/prismatic kinematics identical).
    -->
  <arg name="model" default="$(find lexium_cobot_with_final_gripper)/urdf/lexium_cobot_v26.urdf"/>
  <arg name="gui" default="true"/>

  <param name="robot_description" command="cat $(arg model)"/>

  <node name="joint_state_publisher_gui" pkg="joint_state_publisher_gui" type="joint_state_publisher_gui" if="$(arg gui)"/>
  <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" unless="$(arg gui)"/>
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>

  <node name="rviz" pkg="rviz" type="rviz" args="-d $(find lexium_cobot_with_final_gripper)/rviz/display.rviz"/>
</launch>
