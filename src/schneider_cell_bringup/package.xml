<?xml version="1.0"?>
<package format="2">
  <name>schneider_cell_bringup</name>
  <version>0.26.0</version>
  <description>
    V20 bringup: principal launch file orchestrating the 11 modular
    packages of the Schneider cell simulation.  YAML of global params,
    RViz config.  NO process logic.
  </description>
  <maintainer email="miguelaor681@outlook.com">Miguel Aor</maintainer>
  <license>BSD</license>
  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>schneider_cell_description</exec_depend>
  <exec_depend>schneider_state_manager</exec_depend>
  <exec_depend>schneider_conveyor_sim</exec_depend>
  <exec_depend>schneider_robot_controller</exec_depend>
  <exec_depend>schneider_gripper_sim</exec_depend>
  <exec_depend>schneider_rotary_fixture_sim</exec_depend>
  <exec_depend>schneider_vision_sim</exec_depend>
  <exec_depend>schneider_object_manager</exec_depend>
  <exec_depend>schneider_visualization</exec_depend>
  <exec_depend>schneider_hmi</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>
  <exec_depend>topic_tools</exec_depend>
</package>
