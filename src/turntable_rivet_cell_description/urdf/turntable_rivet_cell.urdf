<?xml version="1.0"?>
<robot name="turntable_rivet_cell">

  <!--
    URDF generated for RViz/ROS.
    Units: all STL meshes are modeled in millimeters and scaled to meters.
    Main moving joint: table_rotation_joint rotates the indexing disc around Z+ with limits from -180 to +180 degrees. The timing belt is visually attached to nema17_motor_link and to the lower sprocket under the rotating table via turntable_link, with the whole belt assembly raised in Z to sit closer to the rotating table.
    Axis correction: the turntable/base meshes already had the correct orientation,
    so they are kept with rpy=0 0 0. The rivet fixtures, CAFI and piston meshes keep the Y+ to Z+ correction where needed.
    The piston/solenoid assemblies are fixed, and the extra end-effector/pusher links have been removed in this version.
    CAFI drop frames follow the gripper debug-frame convention so the cobot can align its CAFI/grasp frame to the fixture.
    NEMA 17 STEP is included in meshes as reference, but RViz cannot display STEP directly,
    so the motor is represented with primitive URDF geometry.
  -->

  <material name="dark_gray"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="industrial_gray"><color rgba="0.45 0.45 0.45 1"/></material>
  <material name="silver"><color rgba="0.78 0.78 0.78 1"/></material>
  <material name="motor_black"><color rgba="0.05 0.05 0.05 1"/></material>
  <material name="cafi_blue"><color rgba="0.10 0.35 0.95 1"/></material>
  <material name="frame_red"><color rgba="1.0 0.05 0.05 1"/></material>
  <material name="sensor_body"><color rgba="0.10 0.12 0.12 1"/></material>
  <material name="sensor_lens"><color rgba="0.90 0.05 0.05 1"/></material>
  <material name="sensor_ray"><color rgba="0.20 0.95 1.00 0.35"/></material>
  <material name="belt_black"><color rgba="0.01 0.01 0.01 1"/></material>
  <material name="mount_center_green"><color rgba="0.05 1.0 0.25 1.0"/></material>
  <material name="grasp_volume_debug"><color rgba="0.1 0.8 1.0 0.25"/></material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual name="gearbase.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/gearbase.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="gearbase.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/gearbase.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingbase.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingbase.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="bearingbase.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingbase.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="nema_base.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/nema_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="nema_base.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/nema_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingstand_1.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingstand_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="bearingstand_1.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingstand_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingstand_2.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingstand_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="bearingstand_2.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingstand_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingstand_3.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingstand_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="bearingstand_3.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingstand_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="ballbearing_1.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="ballbearing_1.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="ballbearing_2.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="ballbearing_2.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="ballbearing_3.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="ballbearing_3.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="ballbearing_center.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_center.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="ballbearing_center.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/ballbearing_center.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingnut_1.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingnut_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="bearingnut_1.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingnut_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingnut_2.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingnut_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="bearingnut_2.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingnut_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingnut_4.stl_visual">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingnut_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision name="bearingnut_4.stl_collision">
      <origin xyz="-0.268973 -0.252455 -0.001530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingnut_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- NEMA 17 visual placeholder. The original STEP is stored in /meshes as reference. -->
  <joint name="base_to_nema17_motor" type="fixed">
    <parent link="base_link"/>
    <child link="nema17_motor_link"/>
    <origin xyz="0.22936 0.00000 0.05000" rpy="0 0 0"/>
  </joint>

  <link name="nema17_motor_link">
    <visual name="nema17_body_visual">
      <origin xyz="0 0 -0.03" rpy="0 0 0"/>
      <geometry><box size="0.042 0.042 0.040"/></geometry>
      <material name="motor_black"/>
    </visual>
    <visual name="nema17_shaft_visual">
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0025" length="0.025"/></geometry>
      <material name="silver"/>
    </visual>
  </link>



  <!-- Fixed photoelectric sensor for fixture 1 only.
       It is mounted to a small independent pedestal attached directly to base_link, not to the rotating disc or its fixed mechanical base.
       The sensor yaw was rotated 180 degrees from the previous version so the lens/ray points inward toward fixture 1.
       The STEP file is stored as meshes/sick_grte18s_p2312_reference.step, but RViz cannot display STEP directly,
       so this URDF uses simple primitive geometry for the sensor body, lens and light ray. -->
  <joint name="base_link_to_photoelectric_sensor_pedestal_fixture_1" type="fixed">
    <parent link="base_link"/>
    <child link="photoelectric_sensor_pedestal_fixture_1_link"/>
    <!-- Sensor pedestal is now mounted directly to base_link as its own independent stand, not to the turntable base/disc. -->
    <origin xyz="0.255 -0.135 0.018" rpy="0 0 0"/>
  </joint>

  <link name="photoelectric_sensor_pedestal_fixture_1_link">
    <visual name="sensor_pedestal_plate_visual">
      <origin xyz="0 0 -0.004" rpy="0 0 0"/>
      <geometry><box size="0.080 0.050 0.008"/></geometry>
      <material name="industrial_gray"/>
    </visual>
    <collision name="sensor_pedestal_plate_collision">
      <origin xyz="0 0 -0.004" rpy="0 0 0"/>
      <geometry><box size="0.080 0.050 0.008"/></geometry>
    </collision>
    <visual name="sensor_pedestal_post_visual">
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
      <geometry><box size="0.020 0.020 0.080"/></geometry>
      <material name="industrial_gray"/>
    </visual>
    <collision name="sensor_pedestal_post_collision">
      <origin xyz="0 0 0.040" rpy="0 0 0"/>
      <geometry><box size="0.020 0.020 0.080"/></geometry>
    </collision>
  </link>

  <joint name="photoelectric_pedestal_to_sensor_fixture_1" type="fixed">
    <parent link="photoelectric_sensor_pedestal_fixture_1_link"/>
    <child link="photoelectric_sensor_fixture_1_link"/>
    <!-- Yaw corrected: lens faces toward fixture 1 / toward the disc. -->
    <origin xyz="0.000 0.000 0.088" rpy="0 0 0"/>
  </joint>

  <link name="photoelectric_sensor_fixture_1_link">
    <visual name="sick_sensor_body_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.045 0.026 0.026"/></geometry>
      <material name="sensor_body"/>
    </visual>
    <collision name="sick_sensor_body_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.045 0.026 0.026"/></geometry>
    </collision>
    <visual name="sick_sensor_lens_visual">
      <origin xyz="-0.025 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.009" length="0.006"/></geometry>
      <material name="sensor_lens"/>
    </visual>
  </link>

  <joint name="photoelectric_sensor_to_light_ray" type="fixed">
    <parent link="photoelectric_sensor_fixture_1_link"/>
    <child link="photoelectric_light_ray_fixture_1_link"/>
    <!-- Ray points inward from the sensor toward the right side of fixture 1 only. -->
    <origin xyz="-0.120 0 0" rpy="0 0 0"/>
  </joint>

  <link name="photoelectric_light_ray_fixture_1_link">
    <visual name="photoelectric_light_ray_visual">
      <origin xyz="0 0 0" rpy="0 1.570796 0"/>
      <geometry><cylinder radius="0.003" length="0.170"/></geometry>
      <material name="sensor_ray"/>
    </visual>
  </link>

  <!-- Visual timing belt explicitly connected to the NEMA output side and to the lower sprocket under the rotating table.
       The small drive pulley is attached to nema17_motor_link.
       The large driven pulley is attached to turntable_link and is placed below the table at the lower sprocket location.
       The two belt runs are drawn from the motor side toward that lower turntable sprocket. -->
  <joint name="nema17_motor_to_belt_drive_visual" type="fixed">
    <parent link="nema17_motor_link"/>
    <child link="nema_belt_drive_visual_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="nema_belt_drive_visual_link">
    <!-- Clean NEMA driver wrap: single circular belt surface around the NEMA driver. -->
    <visual name="belt_motor_wrap_outer_visual">
      <origin xyz="0.000 0.000 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.030" length="0.014"/></geometry>
      <material name="belt_black"/>
    </visual>
    <visual name="belt_motor_pulley_core_visual">
      <origin xyz="0.000 0.000 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.020" length="0.016"/></geometry>
      <material name="silver"/>
    </visual>
    <visual name="belt_front_run_visual">
      <origin xyz="-0.12218 0.030 0.01" rpy="0 0 0"/>
      <geometry><box size="0.244 0.010 0.012"/></geometry>
      <material name="belt_black"/>
    </visual>
    <visual name="belt_back_run_visual">
      <origin xyz="-0.12218 -0.030 0.01" rpy="0 0 0"/>
      <geometry><box size="0.244 0.010 0.012"/></geometry>
      <material name="belt_black"/>
    </visual>
  </link>

  <joint name="turntable_to_belt_driven_pulley_visual" type="fixed">
    <parent link="turntable_link"/>
    <child link="turntable_belt_driven_pulley_visual_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="turntable_belt_driven_pulley_visual_link">
    <visual name="belt_turntable_pulley_visual">
      <origin xyz="0.000 0.000 -0.018" rpy="0 0 0"/>
      <geometry><cylinder radius="0.068" length="0.012"/></geometry>
      <material name="belt_black"/>
    </visual>
  </link>

  <joint name="table_rotation_joint" type="revolute">
    <parent link="base_link"/>
    <child link="turntable_link"/>
    <origin xyz="-0.015000 0.000000 0.078000" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.141593" upper="3.141593" effort="30" velocity="0.60"/>
    <dynamics damping="0.05" friction="0.01"/>
  </joint>

  <link name="turntable_link">
    <visual name="turntable_disc.stl_visual">
      <origin xyz="-0.253973 -0.252455 -0.079530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/turntable_disc.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision name="turntable_disc.stl_collision">
      <origin xyz="-0.253973 -0.252455 -0.079530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/turntable_disc.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="bearingsprocket.stl_visual">
      <origin xyz="-0.253973 -0.252455 -0.079530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingsprocket.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision name="bearingsprocket.stl_collision">
      <origin xyz="-0.253973 -0.252455 -0.079530" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/bearingsprocket.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Rivet fixture assembly 1 mounted on top of the rotating disc. -->
  <joint name="turntable_to_rivet_fixture_1" type="fixed">
    <parent link="turntable_link"/>
    <child link="rivet_fixture_1_link"/>
    <origin xyz="0.000 -0.030 0.004" rpy="0 0 0"/>
  </joint>

  <link name="rivet_fixture_1_link">
    <visual name="rivet_fixture_top.stl_visual">
      <origin xyz="-0.209707 -0.015035 -0.000132" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/rivet_fixture_top.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="industrial_gray"/>
    </visual>
    <collision name="rivet_fixture_top.stl_collision">
      <origin xyz="-0.209707 -0.015035 -0.000132" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/rivet_fixture_top.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual name="rivet_fixture_bottom.stl_visual">
      <origin xyz="-0.209707 -0.015035 -0.000132" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/rivet_fixture_bottom.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="industrial_gray"/>
    </visual>
    <collision name="rivet_fixture_bottom.stl_collision">
      <origin xyz="-0.209707 -0.015035 -0.000132" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/rivet_fixture_bottom.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <!-- Fixed piston/actuator body. This part does not move. -->
    <visual name="fixture_1_fixed_piston_body_visual">
      <origin xyz="-0.209707 -0.015035 -0.000132" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/piston_good.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="industrial_gray"/>
    </visual>
    <collision name="fixture_1_fixed_piston_body_collision">
      <origin xyz="-0.209707 -0.015035 -0.000132" rpy="1.570796 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/piston_good.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- CAFI drop/grasp frame for fixture 1.
       This frame is placed at the real CAFI center inside the remachado fixture.
       Align the gripper CAFI/grasp frame to this frame to leave the CAFI exactly inside the fixture. -->
  <joint name="fixture_1_to_cafi_lateral_target_frame" type="fixed">
    <parent link="rivet_fixture_1_link"/>
    <child link="fixture_1_cafi_lateral_target_frame"/>
    <origin xyz="0.003276 -0.071389 0.022476" rpy="0 0 0"/>
  </joint>

  <link name="fixture_1_cafi_lateral_target_frame">
    <visual name="fixture_1_drop_frame_marker">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.006"/></geometry>
      <material name="mount_center_green"/>
    </visual>
  </link>

  <joint name="fixture_1_grasp_volume_fixed_joint" type="fixed">
    <parent link="fixture_1_cafi_lateral_target_frame"/>
    <child link="fixture_1_grasp_volume_frame"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="fixture_1_grasp_volume_frame">
    <visual name="fixture_1_grasp_volume_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.126 0.090 0.030"/></geometry>
      <material name="grasp_volume_debug"/>
    </visual>
  </link>

  <!-- CAFI part inside fixture 1. The visual origin/rpy matches the gripper debug CAFI convention from the reference ZIP. -->
  <joint name="fixture_to_cafi_part" type="fixed">
    <parent link="fixture_1_cafi_lateral_target_frame"/>
    <child link="cafi_part_1_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="cafi_part_1_link">
    <visual name="cafi.stl_visual">
      <origin xyz="-0.212983 0.056354 -0.022608" rpy="1.57079632679 0 0"/>
      <geometry>
        <mesh filename="package://turntable_rivet_cell_description/meshes/cafi.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="cafi_blue"/>
    </visual>
    <collision name="cafi.stl_collision">
