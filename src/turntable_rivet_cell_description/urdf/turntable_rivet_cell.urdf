  <!-- Backward-compatible alias frame for old scripts. -->
  <joint name="cafi_part_to_pick_frame" type="fixed">
    <parent link="fixture_1_cafi_lateral_target_frame"/>
    <child link="cafi_pick_frame_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
