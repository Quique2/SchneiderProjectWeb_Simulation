    <origin rpy="0 0 0" xyz="0 0 -0.095"/>
  </joint>
  <!-- ===== V41 Vision zone (DXF #46: 150x151 mm @ (381.5, 215.1)) =====
       V40 instantiated a workstation_table (15 mm grey plate, 150x151)
       to support the fixture_vision STL.  The user flagged that plate
       as "la mesita gris flotante" (zero-length legs made it look like
       a floating plate at z=1.015).  V41 removes the workstation_table
       and mounts the fixture_vision STL DIRECTLY on the mesa top; the
       fixture STL is itself a 15 mm thick cradle plate so it provides
       the visual base.                                                 -->
  <!-- V44: vision zone moved 0.074 m WEST so the cobot has more
       clearance reaching it (reach was OK at V43 but the wrist envelope
       brushed the cradle wall during APPROACH_VISION).  V44 anchor is
       at (0.750, 0.804).  Reach 3D from cobot (1.152, 1.049, 1.000)
       to cradle CAFI centre (0.750, 0.804, 1.0275):
         d = sqrt(0.402^2 + 0.245^2 + 0.028^2) = 0.471 m  (155 mm reach margin) -->
  <link name="vision_zone"/>
  <joint name="world_to_vision_zone" type="fixed">
    <parent link="world"/>
    <child link="vision_zone"/>
    <origin rpy="0 0 0" xyz="0.750 0.804 1.000"/>
  </joint>
  <link name="fixture_2">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="-0.079329 0.058950 0.000000"/>
      <geometry>
        <mesh filename="package://schneider_cell_description/meshes/fixtures/Fixture_para_camara_final.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="fixture_mat"/>
    </visual>
  </link>
  <joint name="vision_zone_to_fixture_2" type="fixed">
    <parent link="vision_zone"/>
    <child link="fixture_2"/>
    <origin rpy="0 0 0" xyz="0 0 0.0"/>
  </joint>
  <!-- V28: explicit cafi_seat frame so object_manager settling can
         look up the world seat pose without falling back.  The seat
         sits at link Z = +0.015 (fixture top) + CAFI_LZ/2 = +0.0275.

         V30 FIX A: rotated 180 deg around link X so the CAFI top
         face aligns with the fixture top (same convention as
         fixture_rivet cafi_seat). -->
  <link name="fixture_2_cafi_seat"/>
  <joint name="fixture_2_to_cafi_seat" type="fixed">
