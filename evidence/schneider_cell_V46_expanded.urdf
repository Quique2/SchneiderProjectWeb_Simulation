    </visual>
  </link>
  <joint name="fixture_A_to_body" type="fixed">
    <parent link="fixture_A"/>
    <child link="fixture_A_body"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="fixture_A_solenoid_left">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="-0.165 +0.0875 0.000"/>
      <geometry>
        <mesh filename="package://schneider_cell_description/meshes/fixtures/rivet_final/fixture_rivet_final_piston.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="fixture_rivet_solenoid"/>
    </visual>
  </link>
  <!-- V30 FIX B: solenoid offset and stroke increased so that the
         piston body is clearly separated from the fixture body and
         the actuation is visible.

         V29 had origin xyz=(0,0,0); the piston bbox in link frame was
         X[-0.163, -0.023], i.e. its inner face touched the fixture body
         at X=-0.023 with no air gap.  V30 shifts the joint origin
         15 mm further in -X so the rest position of the piston is
         X[-0.178, -0.038], i.e. 38 mm clear of the body face.

         The prismatic stroke is also expanded from 10 mm to 30 mm so
         that when rotary_fixture_sim drives the solenoid to its
         lower limit the visual displacement of the piston (and any
         attached settle assist on the CAFI) is clearly visible.
         The sim node will still drive the joint to its `lower` limit
         to "activate" — the larger lower=-0.030 simply produces a
         bigger visible travel. -->
  <joint name="fixture_A_solenoid_left_joint" type="prismatic">
    <parent link="fixture_A"/>
    <child link="fixture_A_solenoid_left"/>
    <origin rpy="0 0 0" xyz="-0.015 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit effort="80.0" lower="-0.030" upper="0.000" velocity="0.15"/>
    <dynamics damping="0.8" friction="0.3"/>
  </joint>
  <!-- NO solenoid_right.  V25 removed it per the user brief and V28
         keeps it removed.  Confirmed by inspection: no
         "${name}_solenoid_right" link or "_joint" anywhere. -->
  <link name="fixture_A_piston"/>
  <joint name="fixture_A_piston_joint" type="prismatic">
    <parent link="fixture_A"/>
    <child link="fixture_A_piston"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit effort="500.0" lower="-0.030" upper="0.000" velocity="0.20"/>
    <dynamics damping="2.0" friction="1.0"/>
  </joint>
  <!-- V42 cafi_seat correction: V41 had seat at link (0.045, 0,
         0.072).  With Rx(pi) the CAFI link Z+ flips so the CAFI body
         occupied fixture Z[0.047, 0.072], leaving a 17 mm air gap
         between the CAFI's lowest face and the fixture body top
         (at fixture Z=0.030).  The user saw this as "CAFI flota un
         poco arriba".  V42 lowers seat Z by 17 mm so the CAFI lowest
         face rests EXACTLY on the body top:
            seat_z (new) = 0.030 (body top) + CAFI_LZ (0.025) = 0.055
         The Rx(pi) rotation is preserved (CAFI top still pointing
         upward in world).                                            -->
  <link name="fixture_A_cafi_seat"/>
  <joint name="fixture_A_to_cafi_seat" type="fixed">
    <parent link="fixture_A"/>
    <child link="fixture_A_cafi_seat"/>
    <origin rpy="3.141592653589793 0 0" xyz="0.045 0.0 0.055"/>
  </joint>
