    <parent link="rotary_table_load_mount"/>
    <child link="fixture_A"/>
    <origin rpy="0 0 0.0" xyz="0 0 0.0"/>
  </joint>
  <link name="fixture_A_base">
    <visual>
      <origin rpy="1.5707963267948966 0 0" xyz="-0.165 +0.0875 0.000"/>
      <geometry>
        <mesh filename="package://schneider_cell_description/meshes/fixtures/rivet_final/fixture_rivet_final_base.STL" scale="0.001 0.001 0.001"/>
      </geometry>
