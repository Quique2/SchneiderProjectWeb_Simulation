  </joint>
  <!-- V40: VISIBLE belt/correa connecting the NEMA drive pulley to the
         disc sprocket.  NEMA centre (per nemabase_1.STL) is at mesh
         (498.333, 252.455, 25.521).  Sprocket centre is at mesh
         (253.973, 252.455, 59.490).  After cx_m / cy_m offset (-0.254,
         -0.252), the NEMA centre lands at link (+0.244, 0, +0.026) and
         the sprocket at link (0, 0, +0.060).  The belt is modelled as
         two parallel flat segments (top + bottom of a closed loop)
         at the average pulley Z = +0.043 m so it's clearly visible
         between the two pulleys.  Pulley OD ~ 50 mm so belt at
         link Y = +-0.026 m skims the outside of each pulley.       -->
  <link name="rotary_table_belt_top">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.244 0.008 0.005"/>
      </geometry>
      <material name="disco_belt_mat"/>
    </visual>
  </link>
  <joint name="rotary_table_to_belt_top" type="fixed">
    <parent link="rotary_table_base_link"/>
    <child link="rotary_table_belt_top"/>
    <origin rpy="0 0 0" xyz="0.122 +0.026 0.052"/>
  </joint>
  <link name="rotary_table_belt_bot">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.244 0.008 0.005"/>
      </geometry>
      <material name="disco_belt_mat"/>
    </visual>
  </link>
