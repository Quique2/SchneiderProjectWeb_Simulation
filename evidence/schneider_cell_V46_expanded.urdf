    <parent link="rotary_table_base_link"/>
    <child link="rotary_table_belt_bot"/>
    <origin rpy="0 0 0" xyz="0.122 -0.026 0.052"/>
  </joint>
  <!-- ============ rotating disc-axis link ============================== -->
  <link name="rotary_table_disc_axis">
    <!-- The visible disc face (400 dia, z=78..81 mm in mesh).  Centred. -->
